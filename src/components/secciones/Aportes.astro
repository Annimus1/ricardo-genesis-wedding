---
import Section from '../Section.astro';
import CopyField from '../CopyField.astro';
import { bankAccounts } from '../../data/wedding';
---

<Section id="aportes" background="white">
	<p class="text-center font-label text-xs tracking-[0.3em] text-deep uppercase">Mesa de regalos</p>
	<h2 class="mt-3 text-center font-serif text-3xl text-ink">Su presencia es nuestro mejor regalo</h2>
	<p class="mx-auto mt-4 max-w-[50ch] text-center font-label text-sm text-deep">
		Si desean hacer un aporte adicional, con mucho cariño dejamos estos datos.
	</p>

	<div class="mx-auto mt-10 max-w-md space-y-8">
		{
			bankAccounts.map((account) => (
				<div class="rounded-sm border border-mist p-6">
					<p class="mb-2 font-serif text-lg text-ink">{account.bank}</p>
					<CopyField label="Titular" value={account.accountHolder} />
					<CopyField label="Tipo de cuenta" value={account.accountType} />
					<CopyField label="Número de cuenta" value={account.accountNumber} />
					<CopyField label={account.idLabel} value={account.idNumber} />
				</div>
			))
		}
	</div>
</Section>

<script>
	import '../../scripts/copy.ts';
</script>
