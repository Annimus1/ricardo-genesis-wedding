---
import Section from '../Section.astro';
import LinkButton from '../LinkButton.astro';
import { rsvp } from '../../data/wedding';

const hasPhone = rsvp.whatsappPhone !== 'PENDIENTE';
const waHref = hasPhone ? `https://wa.me/${rsvp.whatsappPhone}?text=${encodeURIComponent(rsvp.message)}` : undefined;
---

<Section id="confirmacion" background="sky">
	<p class="text-center font-label text-xs tracking-[0.3em] text-deep uppercase">Confirmación de asistencia</p>
	<h2 class="mt-3 text-center font-serif text-3xl text-ink">Esperamos contar contigo</h2>
	<p class="mx-auto mt-4 max-w-[50ch] text-center font-label text-sm text-deep">
		Por favor confirma tu asistencia antes del {rsvp.deadlineDisplay}.
	</p>

	<div class="mt-8 flex justify-center">
		{
			hasPhone ? (
				<LinkButton href={waHref!} external variant="solid" class="px-8">
					Confirmar por WhatsApp
				</LinkButton>
			) : (
				<p class="font-label text-sm text-deep">PENDIENTE: número de contacto</p>
			)
		}
	</div>

	{
		hasPhone && (
			<p class="mt-4 text-center font-label text-xs text-deep">
				También puedes escribirnos al {rsvp.whatsappPhone}
			</p>
		)
	}
</Section>
