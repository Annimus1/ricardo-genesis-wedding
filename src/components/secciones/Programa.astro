---
import Section from '../Section.astro';
import { program } from '../../data/wedding';
---

<Section id="programa" background="mist">
	<p class="text-center font-label text-xs tracking-[0.3em] text-deep uppercase">Programa</p>
	<h2 class="mt-3 text-center font-serif text-3xl text-ink">Así celebraremos</h2>

	<ol class="mt-14">
		{
			program.map((item) => (
				<li class="relative border-l border-champagne/40 py-1 pb-10 pl-8 last:pb-0">
					<span
						class="absolute top-2 -left-[5px] h-2.5 w-2.5 rounded-full border-2 border-champagne bg-mist"
						aria-hidden="true"
					/>
					<span class="font-label text-xs tracking-[0.2em] text-dusty uppercase">{item.time}</span>
					<p class="mt-1 font-serif text-xl text-ink">{item.title}</p>
					{item.description && <p class="mt-1 font-label text-sm text-deep">{item.description}</p>}
				</li>
			))
		}
	</ol>
</Section>
