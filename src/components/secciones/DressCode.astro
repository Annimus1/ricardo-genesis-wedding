---
import Section from '../Section.astro';
import { dressCode } from '../../data/wedding';
---

<Section id="dress-code" background="sky">
	<p class="text-center font-label text-xs tracking-[0.3em] text-deep uppercase">Código de vestimenta</p>
	<h2 class="mt-3 text-center font-serif text-3xl text-ink">{dressCode.label}</h2>

	<ul class="mt-10 flex flex-wrap justify-center gap-6">
		{
			dressCode.suggestedColors.map((color) => (
				<li class="flex flex-col items-center gap-2">
					<span
						class="h-12 w-12 rounded-full border border-ink/10"
						style={`background-color: ${color.hex}`}
						aria-hidden="true"
					/>
					<span class="font-label text-xs tracking-[0.1em] text-deep">{color.name}</span>
				</li>
			))
		}
	</ul>

	<p class="mx-auto mt-10 max-w-[50ch] text-center font-label text-sm text-deep">{dressCode.note}</p>
</Section>
