---
import Ornament from '../Ornament.astro';
import { couple, weddingDateDisplay } from '../../data/wedding';
---

<footer class="bg-ink px-6 py-14 text-center">
	<p class="font-script text-3xl text-champagne">R&amp;G</p>
	<Ornament class="my-4" />
	<p class="font-label text-xs tracking-[0.2em] text-white/70 uppercase">
		{weddingDateDisplay.day} de {weddingDateDisplay.month} de {weddingDateDisplay.year}
	</p>
	<p class="mt-2 font-label text-xs tracking-[0.15em] text-white/70">{couple.hashtag}</p>
</footer>
