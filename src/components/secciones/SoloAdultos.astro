---
import Section from '../Section.astro';
import Ornament from '../Ornament.astro';
import { adultsOnlyNote } from '../../data/wedding';
---

<Section id="solo-adultos" class="relative overflow-hidden py-16">
    <!-- IMAGEN DE FONDO -->
    <div 
        class="absolute inset-0 bg-cover bg-center z-0" 
        style="background-image: url('https://images.unsplash.com/photo-1523438885200-e635ba2c371e?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"
    ></div>

    <!-- CAPA OSCURA (Overlay) para asegurar la legibilidad -->
    <div class="absolute inset-0 bg-black/60 z-10"></div>

    <!-- CONTENIDO (Texto y ornamentos por encima) -->
    <div class="relative z-20 text-white">
        <Ornament class="mb-8 brightness-0 invert" />
        <p class="mx-auto max-w-[50ch] text-center font-serif text-lg text-white italic sm:text-xl drop-shadow-md">
            {adultsOnlyNote}
        </p>
        <Ornament class="mt-8 brightness-0 invert" />
    </div>
</Section>
