---
interface Props {
	href: string;
	external?: boolean;
	download?: string;
	variant?: 'outline' | 'solid';
	class?: string;
}

const { href, external = false, download, variant = 'outline', class: className } = Astro.props;

const variantClass = {
	outline: 'border border-deep text-deep hover:bg-deep hover:text-white',
	solid: 'border border-deep bg-deep text-white hover:bg-ink hover:border-ink',
}[variant];
---

<a
	href={href}
	download={download}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'w-80 text-md inline-flex min-h-11 items-center justify-center gap-2 rounded-sm px-5 font-label tracking-[0.15em] uppercase transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep',
		variantClass,
		className,
	]}
>
	<slot />
</a>
