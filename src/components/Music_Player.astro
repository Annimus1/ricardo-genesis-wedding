<audio id="music-player" loop preload="auto" class="hidden">
  <source src="/music.mp3" type="audio/mpeg" />
  Tu navegador no soporta el elemento de audio.
</audio>

<!-- Banner para solicitar permiso de audio -->
<div id="audio-consent-modal" class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 z-50 max-w-sm bg-black/90 text-white p-4 rounded-xl shadow-2xl backdrop-blur flex items-center justify-between gap-4 border border-white/10">
  <div class="text-xs">
    <p class="font-semibold">¿Activar música de fondo? 🎵</p>
    <p class="text-gray-400">Puedes pausarla en cualquier momento.</p>
  </div>
  <div class="flex gap-2">
    <button id="btn-allow-audio" class="px-3 py-1.5 bg-white text-black text-xs font-semibold rounded-lg hover:bg-gray-200 transition">
      Sí
    </button>
    <button id="btn-deny-audio" class="px-3 py-1.5 bg-white/10 text-xs font-semibold rounded-lg hover:bg-white/20 transition">
      No
    </button>
  </div>
</div>

<!-- Botón flotante de control (Oculto hasta que el usuario responda o interactúe) -->
<button id="music-toggle" aria-label="Reproducir o pausar música" class="hidden fixed bottom-4 right-4 z-50 p-3 bg-black/80 text-white rounded-full shadow-lg backdrop-blur border border-white/10">
  <span id="music-icon">🎵</span>
</button>

<script>
  const audio = document.getElementById('music-player') as HTMLAudioElement | null;
  const toggleBtn = document.getElementById('music-toggle') as HTMLButtonElement | null;
  const icon = document.getElementById('music-icon');
  
  const consentModal = document.getElementById('audio-consent-modal');
  const btnAllow = document.getElementById('btn-allow-audio');
  const btnDeny = document.getElementById('btn-deny-audio');

  if (audio && toggleBtn && consentModal && btnAllow && btnDeny) {
    audio.volume = 0.50;

    const updateUI = (isPlaying: boolean) => {
      if (icon) icon.textContent = isPlaying ? '🔊' : '🔇';
    };

    const playAudio = () => {
      audio.play().then(() => {
        updateUI(true);
      }).catch(err => {
        console.error("Error al reproducir audio:", err);
      });
    };

    // Aceptar permiso
    btnAllow.addEventListener('click', () => {
      consentModal.classList.add('hidden');
      toggleBtn.classList.remove('hidden');
      playAudio();
    });

    // Denegar permiso
    btnDeny.addEventListener('click', () => {
      consentModal.classList.add('hidden');
      toggleBtn.classList.remove('hidden');
      updateUI(false);
    });

    // Control del botón flotante una vez aceptado o denegado
    toggleBtn.addEventListener('click', () => {
      if (audio.paused) {
        playAudio();
      } else {
        audio.pause();
        updateUI(false);
      }
    });
  }
</script>