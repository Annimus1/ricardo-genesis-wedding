---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div
	class:list={['flex items-center justify-center gap-4', className]}
	aria-hidden="true"
	role="presentation"
>
	<span class="h-px w-16 bg-champagne/60"></span>
	<span class="h-2 w-2 rotate-45 bg-champagne"></span>
	<span class="h-px w-16 bg-champagne/60"></span>
</div>
